  <version>0.0.0</version>
  <description>Top-level launch files for simulation and real robot</description>
  <maintainer email="186585487+sinann-emree@users.noreply.github.com">Sinan Emre</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fsb_description</exec_depend>
  <exec_depend>fsb_control</exec_depend>
  <exec_depend>fsb_gazebo</exec_depend>
  <exec_depend>fsb_navigation</exec_depend>
  <exec_depend>fsb_patrol</exec_depend>
  <exec_depend>nav2_rviz_plugins</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
