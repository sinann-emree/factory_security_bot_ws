<?xml version="1.0"?>
<!--
  fsb_properties.xacro — FİZİKSEL PARAMETRELERİN TEK KAYNAĞI (tasarım kuralı)

  Referans: ~/reference/andino @ 974264b (Ekumen-OS/andino, main). Yalnızca ölçü kaynağı;
  andino dosyaları kopyalanmadı. Aşağıda "andino <dosya>:<satır>" = değerin kaynağı.
  andino yaml yolları: andino_description/config/andino/

  ÇERÇEVE DÖNÜŞÜMÜ
  "A" = andino'nun base_link çerçevesi. Bizim base_link'imiz iki tekerlek milinin orta
  noktasındadır (diferansiyel sürüşün dönme merkezi). Bu yüzden andino'dan alınan her konum:
      bizim_xyz = A_xyz - (a_wheel_x, 0, a_wheel_z)
  ile çevrilir.

  Bu dosyadaki değerler değişirse fsb_control/config/controllers.yaml da güncellenmelidir;
  test/test_params_consistency.py bu uyumu build testinde zorlar.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.14159265"/>

  <!-- ============================ TEKERLEK ============================ -->
  <xacro:property name="wheel_radius" value="0.0331"/>   <!-- andino wheel.yaml:2 -->
  <xacro:property name="wheel_width"  value="0.025"/>    <!-- andino wheel.yaml:3 -->
  <xacro:property name="wheel_mass"   value="0.032"/>    <!-- andino wheel.yaml:1 -->
  <!-- wheel_separation = 2 * (motor.y_offset + wheel.y_offset) = 2 * (0.038279 + 0.025721) = 0.128
       (andino motor.yaml:8 + wheel.yaml:7, formül common_macros.urdf.xacro:21,68).
       andino_controllers.yaml:18'deki 0.137 URDF ile çeliştiği için KULLANILMADI (kullanıcı kararı 2026-11-15).
       Gerçek kalibrasyon: Aşama 7. -->
  <xacro:property name="wheel_separation" value="0.128"/>

  <!-- Tekerlek milinin A çerçevesindeki konumu (çerçeve dönüşümü için) -->
  <xacro:property name="a_wheel_x" value="${0.032223 + 0.016438}"/>  <!-- = 0.048661; andino motor.yaml:7 + wheel.yaml:6 -->
  <xacro:property name="a_wheel_z" value="${0.011253 + 0.0}"/>       <!-- = 0.011253; andino motor.yaml:9 + wheel.yaml:8 -->

  <!-- ===================== ZEMİN TEMASI HESABI =======================
       Hedef: tekerleğin en alt noktası base_footprint z=0'da olsun (havada boşluk / gömülme yok).
         base_footprint -> base_link     : z = base_link_height
         base_link      -> *_wheel_joint : z = 0 (base_link mil yüksekliğinde)
         Tekerlek alt noktası (base_footprint'te) = base_link_height + 0 - wheel_radius
       => base_link_height = wheel_radius = 0.0331  ⇒  alt nokta = 0.0331 - 0.0331 = 0  ✔
       Not: andino'da footprint z = -(r - wheel.z_offset) = -0.0331 alınıp motor.z_offset (0.011253)
       hesaba katılmadığı için tekerlek zeminin ~1.1 cm üstünde kalıyordu; burada düzeltildi. -->
  <xacro:property name="base_link_height" value="${wheel_radius}"/>

  <!-- ============================= GÖVDE ============================== -->
  <xacro:property name="chassis_x" value="0.25"/>   <!-- andino base.yaml:3 -->
  <xacro:property name="chassis_y" value="0.1"/>    <!-- andino base.yaml:4 -->
  <xacro:property name="chassis_z" value="0.05"/>   <!-- andino base.yaml:5 -->
  <!-- Gövde kutusu merkezi: A'da (-0.02, 0, z/2) (andino common_macros.urdf.xacro:179) -->
  <xacro:property name="chassis_cx" value="${-0.02 - a_wheel_x}"/>          <!-- = -0.068661 -->
  <xacro:property name="chassis_cz" value="${chassis_z / 2.0 - a_wheel_z}"/> <!-- =  0.013747 → alt yüzey zeminden 0.021847 m yukarıda -->

  <!-- base_link toplu kütlesi (gövde + iki üst kat + iki motor; hepsi base_link'e sabit):
       0.8 (base.yaml:2) + 0.8 (lidar_base.yaml:2) + 0.8 (battery_base.yaml:2) + 2*0.1 (motor.yaml:1) = 2.6 kg
       Atalet: gövde tabanından LiDAR altına kadar uzanan düzgün kutu yaklaşımı.
       Kutu yüksekliği (A'da z=0 → LiDAR alt yüzü) = laser.dz - laser.length/2 = 0.084808 - 0.005 = 0.079808 -->
  <xacro:property name="body_mass"   value="${0.8 + 0.8 + 0.8 + 2 * 0.1}"/>
  <xacro:property name="body_z"      value="${0.084808 - 0.01 / 2.0}"/>
  <xacro:property name="body_com_x"  value="${chassis_cx}"/>
  <xacro:property name="body_com_z"  value="${body_z / 2.0 - a_wheel_z}"/>  <!-- = 0.028651 -->

  <!-- ============================= CASTER ============================= -->
  <xacro:property name="caster_radius" value="0.010747"/>  <!-- andino caster_wheel.yaml:3 -->
  <xacro:property name="caster_mass"   value="0.5"/>       <!-- andino caster_wheel.yaml:2 -->
  <xacro:property name="caster_x"      value="${-0.0754 - a_wheel_x}"/>  <!-- = -0.124061; andino caster_wheel.yaml:9 -->
  <!-- Caster de zemine değmeli (3 temas noktası aynı düzlemde, robot eğik durmaz):
         küre merkezi (base_footprint'te) = caster_radius ⇒ base_link'te z = caster_radius - base_link_height
       = 0.010747 - 0.0331 = -0.022353.
       andino dz (caster_wheel.yaml:11, -0.003) aynen alınsaydı küre zemine 2.65 mm gömülürdü. -->
  <xacro:property name="caster_z" value="${caster_radius - base_link_height}"/>

  <!-- ============================ SENSÖRLER =========================== -->
  <!-- LiDAR (RPLidar A1): andino sensors.yaml:2-8; 180° dönük montaj (tasarım kuralı,
       andino common_sensors.urdf.xacro:45'te de rpy 0 0 π) -->
  <xacro:property name="lidar_mass"   value="0.1"/>    <!-- andino sensors.yaml:2 -->
  <xacro:property name="lidar_radius" value="0.015"/>  <!-- andino sensors.yaml:3 -->
  <xacro:property name="lidar_length" value="0.01"/>   <!-- andino sensors.yaml:4 -->
  <xacro:property name="lidar_xyz" value="${0.0666 - a_wheel_x} 0 ${0.084808 - a_wheel_z}"/>  <!-- = 0.017939 0 0.073555; andino sensors.yaml:6-8 -->
  <xacro:property name="lidar_rpy" value="0 0 3.14159265"/>

  <!-- Kamera: andino sensors.yaml:11-16 -->
  <xacro:property name="camera_mass" value="0.1"/>   <!-- andino sensors.yaml:11 -->
  <xacro:property name="camera_size" value="0.02"/>  <!-- andino sensors.yaml:12 -->
  <xacro:property name="camera_xyz" value="${0.098 - a_wheel_x} 0 ${0.025 - a_wheel_z}"/>  <!-- = 0.049339 0 0.013747; andino sensors.yaml:14-16 -->

  <!-- IMU: andino'da IMU linki YOK (kullanıcı kararı 2026-11-15).
       Konum: iki tekerleğin orta noktasının (x=0, y=0) tam üstü, gövde üst yüzeyinde.
       Gerekçe: x=y=0 diferansiyel sürüşün dönme ekseni üzerindedir; eksen üzerindeki noktada
       merkezcil ivme ω×(ω×r) = 0 ve teğetsel ivme α×r = 0 olur, ivmeölçer yalnızca öteleme
       ivmesini ölçer ⇒ EKF'ye (Aşama 4) temiz veri. Yükseklik yaw ölçümünü etkilemez. -->
  <xacro:property name="imu_xyz"  value="0 0 ${chassis_cz + chassis_z / 2.0}"/>  <!-- = 0 0 0.038747 -->
  <xacro:property name="imu_size" value="0.01"/>   <!-- VARSAYIM: tipik IMU kartı; andino'da yok -->
  <xacro:property name="imu_mass" value="0.005"/>  <!-- VARSAYIM: ihmal edilebilir küçük kütle; Aşama 7'de ölç -->

  <!-- ===================== SİMÜLASYON SENSÖR PARAMETRELERİ ==============
       (Aşama 4) andino deposunda sensör sim parametresi yok (andino_gz ayrı depo, referans alınmadı).
       LiDAR değerleri RPLidar A1 sınıfına göre (andino sensors.yaml:5 mesh adı 'rplidar-a1'):
       menzil 0.15–12 m, ~1° çözünürlük. Diğerleri proje seçimi; gerçek sürücüler Aşama 7. -->
  <xacro:property name="lidar_update_rate" value="10"/>     <!-- Hz; çıkış kriteri /scan >= 10 Hz -->
  <xacro:property name="lidar_samples"     value="360"/>    <!-- 1° çözünürlük -->
  <xacro:property name="lidar_range_min"   value="0.15"/>   <!-- m, RPLidar A1 sınıfı -->
  <xacro:property name="lidar_range_max"   value="12.0"/>   <!-- m, RPLidar A1 sınıfı -->
  <xacro:property name="lidar_noise_std"   value="0.01"/>   <!-- m, gauss; proje seçimi -->

  <xacro:property name="camera_update_rate" value="15"/>    <!-- Hz; YOLO 5 Hz için yeterli -->
  <xacro:property name="camera_width"       value="640"/>
  <xacro:property name="camera_height"      value="480"/>
  <xacro:property name="camera_hfov"        value="1.085"/> <!-- rad = 62.2°, RPi Camera v2 sınıfı; VARSAYIM -->
  <xacro:property name="camera_clip_near"   value="0.02"/>
  <xacro:property name="camera_clip_far"    value="30.0"/>
  <!-- Lens/optik çerçeve kökeni: kamera kutusunun ön yüzünün 1 mm önü.
       camera_link x = 0.049339 → lens x = 0.049339 + 0.011 = 0.060339 (base_link);
       gövde ön yüzü x = chassis_cx + chassis_x/2 = 0.056339 → lens gövdenin 4 mm önünde,
       görüntü gövdeye takılmaz (Aşama 2 notu). -->
  <xacro:property name="camera_lens_offset" value="${camera_size / 2.0 + 0.001}"/>

  <xacro:property name="imu_update_rate"   value="100"/>    <!-- Hz -->
  <xacro:property name="imu_gyro_noise_std" value="0.001"/> <!-- rad/s, gauss; proje seçimi -->
  <xacro:property name="imu_accel_noise_std" value="0.017"/> <!-- m/s², gauss; proje seçimi -->

  <!-- ========================== SÜRTÜNME (Gazebo) ======================
       andino_gz deposu referans alınmadığından kaynak yok; proje seçimi.
       Doğrulama: Aşama 3 kayma testi (1 m düz, 360° dönüş). -->
  <xacro:property name="wheel_mu"  value="1.0"/>   <!-- kauçuk/zemin: yüksek, kayma ≈ 0 -->
  <xacro:property name="caster_mu" value="0.01"/>  <!-- serbest caster: çok düşük -->

</robot>
